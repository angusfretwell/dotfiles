#!/usr/bin/env bash
set -euo pipefail

if ! command -v docker &>/dev/null; then
	curl -fsSL https://get.docker.com | sh
fi

sudo install -d /etc/docker
sudo tee /etc/docker/daemon.json >/dev/null <<-EOT
	{
	  "ip": "127.0.0.1",
	  "log-driver": "local"
	}
EOT
sudo systemctl restart docker
sudo usermod -aG docker "$USER"
