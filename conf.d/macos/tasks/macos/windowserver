#!/usr/bin/env bash
#MISE description="Enable HiDPI display modes"
#MISE dir="{{ env.HOME }}"
#MISE interactive=true
set -euo pipefail

plist=/Library/Preferences/com.apple.windowserver

if [[ "$(defaults read "$plist" DisplayResolutionEnabled 2>/dev/null)" != 1 ]]; then
	sudo defaults write "$plist" DisplayResolutionEnabled -bool true
fi
