{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v docker &>/dev/null; then
	sudo install -d -m 755 /etc/apt/keyrings
	sudo curl -fsSL https://download.docker.com/linux/$(. /etc/os-release && echo "$ID")/gpg -o /etc/apt/keyrings/docker.asc
	sudo tee /etc/apt/sources.list.d/docker.sources >/dev/null <<-EOT
		Types: deb
		URIs: https://download.docker.com/linux/$(. /etc/os-release && echo "$ID")
		Suites: $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
		Components: stable
		Signed-By: /etc/apt/keyrings/docker.asc
	EOT
	sudo apt-get update
	sudo DEBIAN_FRONTEND=noninteractive apt-get -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
fi

sudo install -d /etc/docker
sudo tee /etc/docker/daemon.json >/dev/null <<-EOT
	{
	  "ip": "127.0.0.1",
	  "log-driver": "local"
	}
EOT
sudo systemctl restart docker
sudo usermod -aG docker "$USER"
{{ end -}}
