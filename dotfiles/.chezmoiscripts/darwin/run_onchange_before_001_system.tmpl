#!/usr/bin/env bash
set -euo pipefail
# MacOS build version: {{ output "sw_vers" "--buildVersion" }}

clt_label=$(softwareupdate --list 2>/dev/null |
	sed -n 's/^\* Label: \(Command Line Tools.*\)$/\1/p' | sort -V | tail -n1)

if [[ -n "$clt_label" ]]; then
	sudo softwareupdate --install "$clt_label"
fi
