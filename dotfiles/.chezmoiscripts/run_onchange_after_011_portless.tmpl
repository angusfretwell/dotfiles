#!/usr/bin/env bash
set -euo pipefail

{{ template "script-path" . }}

state="$HOME/.portless"
item="op://Workbox/Workbox CA"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

{{ template "op-signin" . }}
op read "$item/workbox-ca.crt" >"$tmp/ca.pem"

if ! cmp -s "$tmp/ca.pem" "$state/ca.pem"; then
	portless clean
	mkdir -p "$state"
	install -m 644 "$tmp/ca.pem" "$state/ca.pem"
	(umask 077 && op read "$item/workbox-ca.key" >"$state/ca-key.pem")
fi

portless trust
