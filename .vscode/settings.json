{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "files.associations": {
    "**/tasks/**": "shellscript",
    "**/scripts/**/*.tera": "shellscript",
    "**/dotfiles/shell/*.tera": "shellscript",
    "**/CLAUDE.md.tera": "markdown",
    "**/dotfiles/git/config.tera": "properties"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  "[toml]": {
    "editor.defaultFormatter": "tombi-toml.tombi"
  }
}
