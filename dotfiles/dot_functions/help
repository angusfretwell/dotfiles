#!/bin/zsh

local input=$(
	cat <<EOF
You are a Linux shell command expert.

Task: Write a single shell command that accomplishes the following goal:
<goal>
$*
</goal>

Rules:
- Output ONLY the command and a 1-2 sentence explanation
- Do NOT execute the command
- Do NOT add warnings or caveats
- Do NOT wrap lines. Keep each line of output on a single line.

Response format (use exactly this markdown structure):

\`\`\`sh
<your command here>
\`\`\`

**Explanation:** <short explanation>
EOF
)

claude_print --model haiku --effort low "$input" | glow
