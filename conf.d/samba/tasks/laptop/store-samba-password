#!/usr/bin/env bash
#MISE description="Store the workbox SMB password in the login keychain"
#MISE dir="{{ env.HOME }}"
set -euo pipefail

if security find-internet-password -a "$USER" -s workbox -r "smb " &>/dev/null; then
	exit 0
fi

netauth=/System/Library/CoreServices/NetAuthAgent.app/Contents/MacOS
security add-internet-password -a "$USER" -s workbox -r "smb " -l workbox \
	-T "$netauth/NetAuthAgent" -T "$netauth/NetAuthSysAgent" \
	-w "$(op read "op://Workbox/Samba/password")"
