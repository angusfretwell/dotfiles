#!/usr/bin/env bash
#MISE description="Install the Android SDK packages and emulator"
#MISE dir="{{ env.HOME }}"
set -euo pipefail

export ANDROID_HOME="$HOME/Library/Android/sdk"

if [[ ! -d "$ANDROID_HOME/platform-tools" || ! -d "$ANDROID_HOME/emulator" ||
	! -d "$ANDROID_HOME/platforms/android-36" || ! -d "$ANDROID_HOME/cmdline-tools/latest" ]]; then
	android --no-metrics sdk install platform-tools emulator platforms/android-36 cmdline-tools/latest
fi

if [[ ! -d "$HOME/.android/avd/medium_tablet.avd" ]]; then
	android --no-metrics emulator create medium_tablet
fi
