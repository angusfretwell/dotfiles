{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

{{ template "script-path" . }}

if ! command -v t3 &>/dev/null; then
	curl -fsSL https://t3.codes/install.sh | T3CODE_CHANNEL=nightly sh
elif [[ "$(t3 --version)" != *-nightly.* ]]; then
	t3 update --channel nightly --yes
fi

sudo loginctl enable-linger "$USER"

t3 service install

mkdir -p "$HOME/.config/systemd/user/t3code.service.d"
tee "$HOME/.config/systemd/user/t3code.service.d/limits.conf" >/dev/null <<-EOT
	[Service]
	MemoryHigh=70%
	CPUWeight=50
EOT
systemctl --user daemon-reload

portless alias t3 3773 --force
{{ end -}}
