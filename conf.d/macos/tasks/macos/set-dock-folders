#!/usr/bin/env bash
#MISE description="Pin folders to the Dock"
set -euo pipefail

folders=(
	"$HOME/Desktop dateadded fan"
	"$HOME/Downloads dateadded fan"
	"/Volumes/Workbox dateadded fan"
	"$HOME/Screenshots dateadded fan"
)

sort_code() {
	case $1 in
	name) echo 1 ;;
	dateadded) echo 2 ;;
	datemodified) echo 3 ;;
	datecreated) echo 4 ;;
	kind) echo 5 ;;
	esac
}

view_code() {
	case $1 in
	auto) echo 0 ;;
	fan) echo 1 ;;
	grid) echo 2 ;;
	list) echo 3 ;;
	esac
}

present=()
wanted=()
for folder in "${folders[@]}"; do
	read -r path sort view <<<"$folder"
	[[ -d $path ]] || continue
	present+=("$folder")
	wanted+=("$path $(sort_code "$sort") $(view_code "$view")")
done

prefs=$(mktemp)
trap 'rm -f "$prefs"' EXIT
defaults export com.apple.dock "$prefs"

tile() {
	plutil -extract "persistent-others.$1.tile-data.$2" raw "$prefs" 2>/dev/null || true
}

current=()
labels=()
count=$(plutil -extract persistent-others raw "$prefs" 2>/dev/null || echo 0)
for ((i = 0; i < count; i++)); do
	url=$(tile "$i" file-data._CFURLString)
	url=${url#file://}
	current+=("${url%/} $(tile "$i" arrangement) $(tile "$i" showas)")
	labels+=("$(tile "$i" file-label)")
done

[[ ${current[*]} == "${wanted[*]}" ]] && exit 0

for label in "${labels[@]}"; do
	dockutil --remove "$label" --no-restart
done

for folder in "${present[@]}"; do
	read -r path sort view <<<"$folder"
	dockutil --add "$path" --sort "$sort" --view "$view" --display stack --no-restart
done

killall Dock
