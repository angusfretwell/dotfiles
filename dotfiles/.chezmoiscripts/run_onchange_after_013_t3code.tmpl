{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

{{ template "script-path" . }}

if ! command -v t3 &>/dev/null; then
	curl -fsSL https://t3.codes/install.sh | sh
elif [[ "$(t3 --version)" == *-* ]]; then
	t3 update --channel stable --allow-downgrade --yes
fi

sudo loginctl enable-linger "$USER"

t3 service install

mkdir -p "$HOME/.config/systemd/user/t3code-.scope.d" "$HOME/.config/systemd/user.conf.d"
tee "$HOME/.config/systemd/user/t3code-.scope.d/oom.conf" >/dev/null <<-EOT
	[Scope]
	OOMPolicy=continue
EOT
tee "$HOME/.config/systemd/user.conf.d/oom.conf" >/dev/null <<-EOT
	[Manager]
	DefaultOOMPolicy=continue
EOT
systemctl --user daemon-reload

portless alias t3 3773 --force
{{ end -}}
