#!/usr/bin/env bash
#MISE description="Restart apps that read macOS defaults at launch"
#MISE dir="{{ env.HOME }}"
#MISE sources=["{{ env.HOME }}/.config/mise/conf.d/macos/mise.macos.toml"]
set -uo pipefail

for app in cfprefsd Dock Finder Mail Photos Safari SystemUIServer; do
	killall "$app" &>/dev/null
done
exit 0
