{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

{{ template "script-path" . }}

if ! command -v tailscale &>/dev/null; then
	curl -fsSL https://tailscale.com/install.sh | sh
fi
sudo systemctl enable --now tailscaled

if ! tailscale status &>/dev/null; then
	{{ template "op-signin" . }}
	sudo tailscale up --auth-key="$(op read "op://Workbox/Tailscale/credential")"
fi
sudo tailscale set --operator="$USER"

sudo tee /etc/ufw/after.init >/dev/null <<-'EOT'
		#!/bin/sh

		rule() {
			table=$1
			chain=$2
			shift 2
			for cmd in iptables ip6tables; do
				case $action in
				start) $cmd -t "$table" -C "$chain" "$@" 2>/dev/null || $cmd -t "$table" -A "$chain" "$@" ;;
				stop) while $cmd -t "$table" -D "$chain" "$@" 2>/dev/null; do :; done ;;
				esac
			done
		}

		action=$1
		if [ "$action" = start ]; then
			iptables -N DOCKER-USER 2>/dev/null || true
			ip6tables -N DOCKER-USER 2>/dev/null || true
		fi

		for iface in lo tailscale0 docker0 br+; do
			rule filter DOCKER-USER -i "$iface" -j RETURN
		done
		rule filter DOCKER-USER -m conntrack --ctstate NEW -j DROP
		for bridge in docker0 br+; do
			rule mangle FORWARD -i "$bridge" -o tailscale0 -m conntrack --ctstate NEW -j DROP
		done
	EOT
sudo chmod 750 /etc/ufw/after.init

sudo ufw --force reset
sudo ufw default deny incoming
sudo ufw default allow outgoing
sudo ufw allow in on tailscale0
sudo ufw allow 41641/udp
sudo ufw --force enable
{{ end -}}
