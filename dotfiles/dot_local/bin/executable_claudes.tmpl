#!/bin/zsh
set -euo pipefail

shared=$HOME/.config/claudes
link=$HOME/.claude

usage() {
	cat <<-EOF
		Usage: claudes <command>

		  list                 List accounts
		  add <name>           Add an account
		  rename <old> <new>   Rename an account
		  remove <name>        Remove an account
		  default <name>       Set the default account
		  sync [<name>]        Apply the managed config to accounts
	EOF
}

die() {
	print -u2 -r -- "claudes: $*"
	exit 1
}

account_dir() {
	print -r -- $HOME/.claude-$1
}

accounts() {
	reply=($HOME/.claude-*(N/:t))
	reply=(${reply#.claude-})
}

default_account() {
	if [[ -L $link ]]; then
		print -r -- ${${link:A:t}#.claude-}
	fi
}

is_unnamed() {
	[[ -d $link && ! -L $link ]]
}

validate_name() {
	[[ $1 =~ '^[a-z0-9][a-z0-9-]*$' ]] || die "invalid account name '$1': use lowercase letters, digits and dashes"
}

require_account() {
	local dir=$(account_dir $1)
	[[ -d $dir && ! -L $dir ]] || die "no such account: $1"
}

require_idle() {
	if ps -Ao args= | grep -E '^([^ ]*/)?claude( |$)' | grep -vq -- '--chrome-native-host'; then
		die "quit all Claude Code sessions first"
	fi
}

login_hint() {
{{- if eq .chezmoi.os "darwin" }}
	print -r -- "Open a new shell, then run claude-$1 and /login."
{{- else }}
	print -r -- "Open a new shell to use claude-$1."
{{- end }}
}

delete_keychain_item() {
{{- if eq .chezmoi.os "darwin" }}
	local hash=$(print -rn -- $1 | shasum -a 256)
	security delete-generic-password -s "Claude Code-credentials-${hash:0:8}" >/dev/null 2>&1 || true
{{- else }}
	:
{{- end }}
}

rewrite_paths() {
	local from=$1 to=$2 file content
	for file in $to/settings.json $to/plugins/installed_plugins.json $to/plugins/known_marketplaces.json; do
		[[ -f $file ]] || continue
		content=$(<$file)
		print -r -- ${content//${(b)from}\//$to/} >$file
	done
}

sync_account() {
	local dir=$1 skill
	print -r -- "Syncing ${dir/#$HOME/~}"
	mkdir -p $dir/skills

	ln -sfn $shared/CLAUDE.md $dir/CLAUDE.md

	[[ -f $dir/settings.json ]] || print '{}' >$dir/settings.json
	jq -s '.[0] * .[1]' $dir/settings.json $shared/settings.json >$dir/settings.json.tmp
	mv $dir/settings.json.tmp $dir/settings.json

	for skill in{{ range .skills }}{{ range . }} {{ . }}{{ end }}{{ end }}; do
		if [[ -d $dir/skills/$skill && ! -L $dir/skills/$skill ]]; then
			rm -rf $dir/skills/$skill
		fi
	done

	(
		if [[ $dir == $link ]]; then
			unset CLAUDE_CONFIG_DIR
		else
			export CLAUDE_CONFIG_DIR=$dir
		fi
{{ range .claudeMarketplaces }}
		claude plugin marketplace add {{ . | quote }}
{{- end }}
{{- range .claudePlugins }}
		claude plugin install {{ . | quote }}
{{- end }}
{{ range $repo, $skills := .skills }}
		npx --yes skills add {{ $repo | quote }} {{ range $skills }}--skill {{ . }} {{ end }}--yes --global --agent claude-code --agent codex{{ if eq $.chezmoi.os "darwin" }} --agent cursor{{ end }}
{{- end }}

		herdr integration install claude
	)
}

cmd_list() {
	local default=$(default_account) name
	if is_unnamed; then
		print -r -- "~/.claude (unnamed: claudes add names it)"
	fi
	accounts
	for name in $reply; do
		if [[ $name == $default ]]; then
			print -r -- "$name (default)"
		else
			print -r -- $name
		fi
	done
}

name_existing_account() {
	local new=$1 name dir
	require_idle
	name=$(gum input --header "Name for the existing ~/.claude account" --placeholder personal)
	validate_name $name
	[[ $name != $new ]] || die "the existing account can't also be called $new"
	dir=$(account_dir $name)
	[[ ! -e $dir ]] || die "$dir already exists"

	mv $link $dir
	if [[ -f $HOME/.claude.json ]]; then
		mv $HOME/.claude.json $dir/.claude.json
	fi
	rewrite_paths $link $dir
	ln -s ${dir:t} $link
	print -r -- "Moved ~/.claude to ${dir/#$HOME/~} and made it the default."
	login_hint $name
}

cmd_add() {
	(( $# == 1 )) || die "usage: claudes add <name>"
	local name=$1 dir=$(account_dir $1)
	validate_name $name
	[[ ! -e $dir ]] || die "account already exists: $name"

	if is_unnamed; then
		name_existing_account $name
	fi

	mkdir $dir
	sync_account $dir
	if [[ ! -L $link ]]; then
		ln -s ${dir:t} $link
	fi
	print -r -- "Added $name."
	login_hint $name
}

cmd_rename() {
	(( $# == 2 )) || die "usage: claudes rename <old> <new>"
	local old=$1 new=$2 from=$(account_dir $1) to=$(account_dir $2) default=$(default_account)
	require_account $old
	validate_name $new
	[[ ! -e $to ]] || die "account already exists: $new"
	require_idle

	mv $from $to
	rewrite_paths $from $to
	if [[ $default == $old ]]; then
		ln -sfn ${to:t} $link
	fi
	delete_keychain_item $from
	print -r -- "Renamed $old to $new."
	login_hint $new
}

cmd_remove() {
	(( $# == 1 )) || die "usage: claudes remove <name>"
	local name=$1 dir=$(account_dir $1)
	require_account $name
	[[ $name != $(default_account) ]] || die "$name is the default account: set another default first"
	require_idle

	gum confirm "Delete ${dir/#$HOME/~} and everything in it?" || exit 1
	rm -rf $dir
	delete_keychain_item $dir
	print -r -- "Removed $name."
}

cmd_default() {
	(( $# == 1 )) || die "usage: claudes default <name>"
	require_account $1
	! is_unnamed || die "~/.claude is still a directory: run claudes add first"
	ln -sfn .claude-$1 $link
	print -r -- "Default is now $1. Shells opened from now on will use it."
}

cmd_sync() {
	(( $# <= 1 )) || die "usage: claudes sync [<name>]"
	local -a dirs
	local dir
	if (( $# )); then
		require_account $1
		dirs=($(account_dir $1))
	else
		accounts
		dirs=($HOME/.claude-${^reply})
		if is_unnamed || { [[ ! -e $link ]] && (( ! $#dirs )) }; then
			dirs+=($link)
		fi
	fi
	for dir in $dirs; do
		sync_account $dir
	done
}

(( $# )) || { usage; exit 1 }
command=$1
shift
case $command in
	list | add | rename | remove | default | sync) cmd_$command "$@" ;;
	-h | --help | help) usage ;;
	*) usage >&2; exit 1 ;;
esac
