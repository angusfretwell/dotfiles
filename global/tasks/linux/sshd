#!/usr/bin/env bash
#MISE description="Harden sshd, refusing to touch it without authorized keys"
#MISE dir="{{ env.HOME }}"
set -euo pipefail

if [[ ! -s $HOME/.ssh/authorized_keys ]]; then
	echo >&2 "no ~/.ssh/authorized_keys; leaving sshd alone so you aren't locked out."
	exit 1
fi

conf=/etc/ssh/sshd_config.d/10-workbox.conf
desired=$(
	cat <<-EOT
		PermitRootLogin no
		PasswordAuthentication no
		KbdInteractiveAuthentication no
		AllowUsers $(id -un)
		X11Forwarding no
		AcceptEnv LANG LC_* COLORTERM
	EOT
)

if [[ $(sudo cat "$conf" 2>/dev/null || true) != "$desired" ]]; then
	backup=$(mktemp)
	trap 'rm -f "$backup"' EXIT
	had_conf=false
	if sudo test -e "$conf"; then
		had_conf=true
		sudo cat "$conf" | tee "$backup" >/dev/null
	fi
	printf '%s\n' "$desired" | sudo install -m 0644 /dev/stdin "$conf"
	if ! sudo sshd -t; then
		if $had_conf; then
			sudo install -m 0644 "$backup" "$conf"
		else
			sudo rm -f "$conf"
		fi
		echo >&2 "sshd -t rejected $conf; restored the previous config."
		exit 1
	fi
	sudo systemctl try-reload-or-restart ssh
fi

sudo rm -f /root/.ssh/authorized_keys
if id linuxuser &>/dev/null; then
	sudo deluser --remove-home linuxuser
fi
