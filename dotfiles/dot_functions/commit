#!/bin/zsh

assert_repo_root || return 1

if [[ -z $(git status --porcelain) ]]; then
	echo >&2 "nothing to commit."
	return 1
fi

local extra=""
if (($#)); then
	extra="Additional instructions: $*"
fi

local input=$(
	cat <<EOF
Use the /commit skill to commit the changes in this repository.

When finished, print only a markdown summary in exactly this format and nothing else:

# wrote <n> <commit|commits>:
- <commit subject> (\`<short hash>\`)
- <commit subject> (\`<short hash>\`)

$extra
EOF
)

print -r -- "$input" | GUM_SPIN_TITLE="Committing..." claude_print \
	--model sonnet --effort high --settings '{"includeCoAuthoredBy": false}' \
	--allowedTools "Read Grep Glob Skill Bash(git status:*) Bash(git diff:*) Bash(git log:*) Bash(git show:*) Bash(git add:*) Bash(git restore:*) Bash(git commit:*)" |
	glow --width 0
