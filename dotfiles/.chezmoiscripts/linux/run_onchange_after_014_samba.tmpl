#!/usr/bin/env bash
set -euo pipefail

{{ template "script-path" . }}

sudo DEBIAN_FRONTEND=noninteractive apt-get -y install --no-install-recommends samba

sudo tee /etc/samba/smb.conf >/dev/null <<'EOT'
{{ template "etc/samba/smb.conf" . -}}
EOT
sudo testparm -s >/dev/null

sudo systemctl disable --now nmbd &>/dev/null || true
sudo systemctl enable smbd
sudo systemctl restart smbd

if ! sudo pdbedit -u "$USER" &>/dev/null; then
	{{ template "op-signin" . }}
	password=$(op read "op://Workbox/Samba/password")
	printf '%s\n%s\n' "$password" "$password" | sudo smbpasswd -a -s "$USER"
fi
