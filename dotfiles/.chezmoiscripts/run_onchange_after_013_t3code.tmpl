{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

{{ template "script-path" . }}

if ! command -v t3 &>/dev/null; then
	curl -fsSL https://t3.codes/install.sh | T3CODE_CHANNEL=nightly sh
elif [[ "$(t3 --version)" != *-nightly.* ]]; then
	t3 update --channel nightly --yes
fi

sudo loginctl enable-linger "$USER"

t3 service install

mkdir -p "$HOME/.config/systemd/user/t3code.service.d" "$HOME/.config/systemd/user/app-t3code.slice.d" "$HOME/.config/systemd/user/app-t3code-agents.slice.d" "$HOME/.config/systemd/user/t3code-.scope.d" "$HOME/.config/systemd/user.conf.d"
tee "$HOME/.config/systemd/user/t3code.service.d/limits.conf" >/dev/null <<-EOT
	[Service]
	MemorySwapMax=0
EOT
tee "$HOME/.config/systemd/user/app-t3code.slice.d/limits.conf" >/dev/null <<-EOT
	[Slice]
	MemoryHigh=80%
	CPUWeight=50
EOT
tee "$HOME/.config/systemd/user/app-t3code-agents.slice.d/limits.conf" >/dev/null <<-EOT
	[Slice]
	MemoryHigh=65%
	MemoryMax=70%
	MemorySwapMax=4G
EOT
tee "$HOME/.config/systemd/user/t3code-.scope.d/oom.conf" >/dev/null <<-EOT
	[Scope]
	OOMPolicy=continue
EOT
tee "$HOME/.config/systemd/user.conf.d/oom.conf" >/dev/null <<-EOT
	[Manager]
	DefaultOOMPolicy=continue
EOT
systemctl --user daemon-reload

portless alias t3 3773 --force
{{ end -}}
