[user]
	name = Angus Fretwell
	email = angusfretwell@me.com

[core]
	excludesfile = ~/.gitignore
	ignorecase = true
	editor = micro
	pager = delta
	mergeoptions = --no-edit

[color]
	ui = true

[merge]
	conflictstyle = zdiff3

[commit]
	template = ~/.gitmessage

[push]
	default = current

[fetch]
	prune = true

[init]
	defaultBranch = main

[status]
	branch = true
	short = true
	untracked-files = all

[submodule]
	recurse = true

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[interactive]
	diffFilter = delta --color-only

# TODO: cursor color scheme
[delta]
	dark = true
	tabs = 2

	file-decoration-style = "#163050" ul
	file-added-label = " "
	file-copied-label = " "
	file-modified-label = " "
	file-removed-label = " "
	file-renamed-label = " "

	line-numbers-left-format = "{nm:>4} "
	line-numbers-right-format = "│ {np:>4} "
	line-numbers-left-style = white dim
	line-numbers-right-style = "#1f2335" dim
	line-numbers-zero-style = white dim
	line-numbers-plus-style = white dim
	line-numbers-minus-style = white dim

	wrap-left-symbol = " "
	wrap-right-symbol = " "
	wrap-right-prefix-symbol = " "

	plus-style = syntax "#0e250e"
	plus-emph-style = syntax "#103610"
	minus-style = syntax "#402a26"
	minus-emph-style = syntax "#45221c"

	hunk-label = ""
	hunk-header-style = "#868E99"
	hunk-header-line-number-style = "#10233A"
	hunk-header-file-style = "#868E99" dim
	hunk-header-decoration-style = "#163050" ul dim

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "status"]
	added = yellow
	changed = green
	untracked = cyan
