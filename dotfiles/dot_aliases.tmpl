#!/bin/zsh

alias dot="chezmoi cd"
alias mcat="glow"

{{ if eq .chezmoi.os "darwin" -}}
alias code=cursor
alias devbox="herdr --remote devbox"
{{- end }}

# Modern replacements for common utils
alias cat=bat
alias df=duf
alias nano=micro
alias ps=procs
alias ls="eza --git --group-directories-first -1"

# Worktrunk shortcuts
alias wts="wt switch"
alias wtp="wt step prune"

# Claude shortcuts
alias cc="assert_repo_root && claude"
alias ccx="assert_repo_root && claude --dangerously-skip-permissions"
