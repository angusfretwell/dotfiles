{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "files.associations": {
    "**/.config/mise/**/tasks/**": "shellscript",
    "**/home/.local/bin/**/*.tera": "shellscript",
    "**/home/.{aliases,bashrc,exports,zshenv,zshrc}.tera": "shellscript",
    "**/CLAUDE.md.tera": "markdown",
    "**/home/.gitconfig.tera": "properties"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  "[toml]": {
    "editor.defaultFormatter": "tombi-toml.tombi"
  }
}
