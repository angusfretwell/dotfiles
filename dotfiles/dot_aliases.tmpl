#!/bin/zsh

alias dot="chezmoi cd"
alias mcat="glow"

{{ if eq .chezmoi.os "darwin" -}}
alias code=cursor
alias workbox="herdr --remote workbox"
{{- end }}

# Modern replacements for common utils
alias cat=bat
alias delta=delta-auto
alias df=duf
alias micro=micro-auto
alias nano=micro-auto
alias ps=procs
alias ls="eza --git --group-directories-first -1"

# Worktrunk shortcuts
alias wts="wt switch"
alias wtp="wt step prune"

# Claude shortcuts
alias cc="assert-repo-root && claude"
alias ccx="assert-repo-root && claude --dangerously-skip-permissions"
