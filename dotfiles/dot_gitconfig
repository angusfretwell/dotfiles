[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
	template = ~/.gitmessage
  	gpgsign = true

[core]
	excludesfile = ~/.gitignore
	ignorecase = true
	editor = micro
	pager = delta
	mergeoptions = --no-edit

[color]
	ui = true

[merge]
	conflictstyle = zdiff3

[push]
	default = current

[fetch]
	prune = true

[init]
	defaultBranch = main

[status]
	branch = true
	short = true
	untracked-files = all

[submodule]
	recurse = true

[interactive]
	diffFilter = delta --color-only

[delta]
    true-color = always
    syntax-theme = Cursor Dark
	dark = true
	tabs = 2
	hunk-header-decoration-style = ul blue dim
	line-numbers-left-format = "{nm:>4} "
	line-numbers-right-format = " {np:>4} "
	wrap-left-symbol = " "
	wrap-right-symbol = " "
	wrap-right-prefix-symbol = " "

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "status"]
	added = yellow
	changed = green
	untracked = cyan
