#!/usr/bin/env bash
set -euo pipefail
# t3code-.scope.d/oom.conf hash: {{ include "dot_config/systemd/user/t3code-.scope.d/oom.conf" | sha256sum }}
# user.conf.d/oom.conf hash: {{ include "dot_config/systemd/user.conf.d/oom.conf" | sha256sum }}

{{ template "script-path" . }}

if ! command -v t3 &>/dev/null; then
	curl -fsSL https://t3.codes/install.sh | T3CODE_CHANNEL=nightly sh
elif [[ "$(t3 --version)" != *-nightly.* ]]; then
	t3 update --channel nightly --yes
fi

sudo loginctl enable-linger "$USER"

t3 service install
systemctl --user daemon-reload

portless alias t3 3773 --force
