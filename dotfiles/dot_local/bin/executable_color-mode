#!/usr/bin/env bash
set -uo pipefail

if ! { exec 3<>/dev/tty; } 2>/dev/null; then
	echo dark
	exit
fi

saved=$(stty -g <&3)
stty raw -echo <&3
printf '\e]11;?\e\\' >&3
IFS= read -r -s -t 0.2 -d '\' -u 3 reply
stty "$saved" <&3

background='rgb:([0-9a-fA-F]{2})[0-9a-fA-F]*/([0-9a-fA-F]{2})[0-9a-fA-F]*/([0-9a-fA-F]{2})'
if [[ ! ${reply:-} =~ $background ]]; then
	echo dark
	exit
fi

luma=$((299 * 16#${BASH_REMATCH[1]} + 587 * 16#${BASH_REMATCH[2]} + 114 * 16#${BASH_REMATCH[3]}))
((luma > 128000)) && echo light || echo dark
