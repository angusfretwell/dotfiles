#!/usr/bin/env bash
set -euo pipefail

repo="$HOME/.dotfiles"

set_hostname() {
	local name
	read -rp "Hostname [laptop]: " name
	name="${name:-laptop}"

	sudo scutil --set ComputerName "$name"
	sudo scutil --set HostName "$name"
	sudo scutil --set LocalHostName "$name"
}

install_xcode_tools() {
	if ! xcode-select -p &>/dev/null; then
		xcode-select --install
		until xcode-select -p &>/dev/null; do
			sleep 5
		done
	fi
}

install_mise() {
	if [[ ! -x $HOME/.local/bin/mise ]]; then
		curl -fsSL https://mise.run | sh
	fi
}

clone_dotfiles() {
	if [[ ! -d $repo ]]; then
		git clone https://github.com/angusfretwell/dotfiles.git "$repo"
	fi
}

link_mise_config() {
	mkdir -p "$HOME/.config"
	if [[ ! -e $HOME/.config/mise ]]; then
		ln -s "$repo" "$HOME/.config/mise"
	elif [[ $(readlink "$HOME/.config/mise") != "$repo" ]]; then
		echo >&2 "$HOME/.config/mise already exists; move it aside and rerun."
		exit 1
	fi
}

set_hostname
install_xcode_tools
install_mise
clone_dotfiles
link_mise_config

MISE_ENV=laptop exec "$repo/conf.d/dotfiles/bin/dot-bootstrap" --yes --save-env --force-dotfiles
